{
    "name": "inspire/formidable",
    "description": "Craft CMS 4 Form builder with Database/Config integration",
    "type": "craft-plugin",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin"
    ],
    "support": {
        "docs": "http://gitlab.inspireservera.com/craft/forms-2/-/wikis/home"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Boris Blondin",
            "homepage": "https://inspire.scot"
        }
    ],
    "require": {
        "craftcms/cms": "^5.0",
        "inspire/emails": "^4.0",
        "inspire/spam-check": "^3.0"
    },
    "autoload": {
        "psr-4": {
          "Inspire\\Formidable\\": "src/"
        }
    },
    "extra": {
        "name": "Formidable Forms",
        "handle": "formidable",
        "class": "Inspire\\Formidable\\Formidable"
    }
}
