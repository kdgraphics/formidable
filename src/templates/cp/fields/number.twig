{% extends "inspireforms/cp/fields/text" %}

{% import "_includes/forms" as forms %}

{% block extraAdvanced %}
    {{
        forms.textField({
            label: "Minimum"|t('inspireforms'),
            name: 'minLength',
            type: "number",
            value: field.minLength,
            errors: field.getErrors('minLength')
        })
    }}
    {{
        forms.textField({
            label: "Maximum"|t('inspireforms'),
            name: 'maxLength',
            type: "number",
            value: field.maxLength,
            errors: field.getErrors('maxLength')
        })
    }}
    {{
        forms.lightswitchField({
            label: "Enforce required"|t('inspireforms'),
            name: 'enforceRequired',
            on: field.enforceRequired
        })
    }}
{% endblock %}