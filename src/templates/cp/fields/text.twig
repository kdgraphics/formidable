{% extends "inspireforms/cp/fields/_field" %}

{% import "_includes/forms" as forms %}

{% block content %}
{{
    forms.textField({
        label: "Label"|t('inspireforms'),
        name: 'label',
        value: field.label,
        errors: field.getErrors('label')
    })
}}
{{
    forms.textField({
        label: "Placeholder"|t('inspireforms'),
        name: 'placeholder',
        value: field.placeholder,
        errors: field.getErrors('placeholder')
    })
}}
{{
    forms.lightswitchField({
        label: "Required"|t('inspireforms'),
        name: 'required',
        on: field.required
    })
}}
{% endblock %}

{% block extraAdvanced %}
    {{
        forms.textField({
            label: "Max length"|t('inspireforms'),
            name: 'maxLength',
            type: "number",
            value: field.maxLength,
            errors: field.getErrors('maxLength')
        })
    }}
{% endblock %}