{% import "_includes/forms" as forms %}

<input type="hidden" name="id" value="{{ field.id }}">
<input type="hidden" name="handle" value="{{ field.handle() }}">

{{
    forms.textField({
        label: "Name"|t('inspireforms'),
        id: 'name',
        name: 'name',
        required: true,
        value: field.name,
        errors: field.getErrors('name')
    })
}}

{% block content %}{% endblock %}

{{
    forms.textareaField({
        label: "Instructions"|t('inspireforms'),
        name: 'instructions',
        value: field.instructions,
        errors: field.getErrors('instructions'),
        wrapperClass: 'instructions'
    })
}}

<div class="actions">
	<a href="#" class="delete">{{ 'Delete'|t('inspireforms') }}</a>
	{% block extraActions %}{% endblock %}
</div>

<div class="advanced">
	<div class="header closed">Advanced</div>
	<div class="content" style="display:none">
		{{
		    forms.textField({
		        label: "Field class"|t('inspireforms'),
		        name: 'fieldClass',
		        value: field.fieldClass
		    })
		}}
		{{
		    forms.textField({
		        label: "Container class"|t('inspireforms'),
		        name: 'containerClass',
		        value: field.containerClass
		    })
		}}
		{% block extraAdvanced %}{% endblock %}
	</div>
</div>