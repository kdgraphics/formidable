<div class="field choices">
	<div class="heading"><label>{{ "Choices"|t('inspireforms') }}</label></div>
	<div class="instructions">{{ "Use {empty} for an empty value"|t('inspireforms') }}</div>
	<div class="list text">
		<ul>
			<li class="skeleton" style="display:none">
				<div class="move-choice">
					<div class="up"></div>
					<div class="down"></div>
				</div>
				<input class="value choice-elem" placeholder="Value">
				<input class="label choice-elem" placeholder="Label">
				<div class="delete-container">
					<a href="#" class="delete-choice">Delete</a>
				</div>
			</li>
			{% if field.choices %}
				{% for key,choice in field.choices %}
					<li class="choice">
						<div class="move-choice">
							<div class="up"></div>
							<div class="down"></div>
						</div>
						<input class="value choice-elem" placeholder="Value" value="{{ choice.value }}" required="required">
						<input class="label choice-elem" placeholder="Label" value="{{ choice.label }}" required="required">
						<div class="delete-container">
							<a href="#" class="delete-choice">Delete</a>
						</div>
					</li>
				{% endfor %}
			{% else %}
				<li class="choice">
					<div class="move-choice">
						<div class="up"></div>
						<div class="down"></div>
					</div>
					<input class="value choice-elem" placeholder="Value" value="{empty}" required="required">
					<input class="label choice-elem" placeholder="Label" value="Select" required="required">
					<div class="delete-container">
						<a href="#" class="delete-choice">Delete</a>
					</div>
				</li>
			{% endif %}
		</ul>
		{% include "_includes/forms/errorList" with {errors:field.getErrors('choices')} %}
		<a class="add-choice" href="#">Add</a>
	</div>
</div>