{% import "_includes/forms" as forms %}

<form method="post" accept-charset="UTF-8" class="notification-form">
    {{ csrfInput() }}
    <input type="hidden" name="action" value="inspireforms/notifications/save" />
    <input type="hidden" name="data[id]" value="{{notification.id}}" />

    {{
        forms.textField({
            label: "Name"|t('inspireforms'),
            id: 'name',
            name: 'data[name]',
            first: true,
            autofocus: true,
            required: true,
            value: notification.name,
            errors: notification.getErrors('name')
        })
    }}

    {{
        forms.selectField({
            label: "Method"|t('inspireforms'),
            id: 'method',
            name: 'data[method]',
            required: true,
            value: notification.method,
            errors: notification.getErrors('method'),
            options: {template:"Template"|t('inspireforms'), html:"Html"|t('inspireforms')}
        })
    }}

    {{
        forms.textField({
            label: "Template"|t('inspireforms'),
            id: 'template',
            name: 'data[template]',
            required: true,
            value: notification.template,
            errors: notification.getErrors('template')
        })
    }}

    {{
        forms.textareaField({
            label: "Html"|t('inspireforms'),
            id: 'html',
            name: 'data[html]',
            required: true,
            instructions: 'Any tag accepted',
            value: notification.html,
            errors: notification.getErrors('html')
        })
    }}

    {{
        forms.textField({
            label: "Subject"|t('inspireforms'),
            id: 'subject',
            name: 'data[subject]',
            required: true,
            instructions: 'Subject for the email',
            value: notification.subject,
            errors: notification.getErrors('subject')
        })
    }}

    {{
        forms.textField({
            label: "Sent from"|t('inspireforms'),
            type: 'email',
            id: 'sentFrom',
            instructions: 'Email address sent from',
            name: 'data[sentFrom]',
            required: true,
            value: notification.sentFrom,
            errors: notification.getErrors('sentFrom')
        })
    }}
    
    <div class="buttons">
        <div class="btngroup submit first">
            <input type="submit" class="btn submit" value="{{ 'Save'|t('inspireforms') }}" />
        </div>
    </div>
</form>