{% extends "_layouts/cp" %}

{% set title = "Notifications" %}

{% set selectedSubnavItem = 'notifications' %}

{% block sidebar %}
	<notifications-menu></notifications-menu>
{% endblock %}

{% block toolbar %}
	<notifications-toolbar></notifications-toolbar>
{% endblock %}

{% block content %}
	<notifications 
		:all-notifications="{{ notifications ? notifications|json_encode : '{}' }}"
		:current-notification="{{ notification|json_encode }}"
	></notifications>
	<confirm-dialog></confirm-dialog>
{% endblock %}