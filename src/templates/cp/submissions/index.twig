{% extends "_layouts/cp" %}

{% set bodyClass = ['formidable'] %}

{% set title = 'Forms submissions'|t('formidable') %}

{% set selectedSubnavItem = 'formidable-submissions' %}

{% block toolbar %}
    <forms-submissions-toolbar
    	:all-forms="{{ forms|json_encode }}"
    	:timezone="'{{ craft.app.getTimeZone() }}'"
    ></forms-submissions-toolbar>
{% endblock %}

{% block content %}
    <forms-submissions></forms-submissions>
{% endblock %}