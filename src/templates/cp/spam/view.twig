

<div class="spam">
	<div class="header header-details">{{ 'Details'|t('inspireforms') }}</div>
	<div class="content content-details">
		<div class="group">
			<label>{{ 'Posted the :'|t('inspireforms') }}</label>
			<div class="value">{{ spam.dateCreated|date('d/m/Y H:i') }}</div>
		</div>
		<div class="group">
			<label>{{ 'Form : '|t('inspireforms') }}</label>
			<div class="value"><a href="/admin/inspireforms/forms/edit/{{ spam.form.id }}" target="_blank">{{ spam.form.name }}</a></div>
		</div>
		<div class="group">
			<label>{{ 'IP :'|t('inspireforms') }}</label>
			<div class="value">{{ spam.ip }}</div>
		</div>
	</div>
	<div class="header header-values">{{ 'Raw values'|t('inspireforms') }}</div>
	<div class="content content-values">
		{% for key, value in values %}
			<div class="group">
				<label>{{ key }} :</label>
				<div class="value">{{ value }}</div>
			</div>
		{% endfor %}
	</div>
</div>