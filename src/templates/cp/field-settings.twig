{% import "_includes/forms" as forms %}

{{ forms.checkboxSelectField({
    label: 'Allowed forms to choose from'|t('formidable'),
    options: forms,
    values: field.allowedForms,
    name: 'allowedForms',
    showAllOption: true
}) }}


<div class="field">
    <div class="heading">
        <legend aria-hidden="true">{{ 'Templates to use on the frontend'|t('formidable') }}</legend>
    </div>
    <div class="input ltr">
        <fieldset>
            {% for uid, form in forms %}
                <div class="flex">
                    <label>{{ form }}: </label>
                    <input type="text" name="templates[{{ uid }}]" class="text" value="{{ field.templates[uid] ?? '' }}" placeholder="use default">
                </div>
            {% endfor %}
        </fieldset>
    </div>
</div>

{{ forms.textField({
    label: 'Default template'|t('formidable'),
    value: field.defaultTemplate,
    name: 'defaultTemplate',
    size: 30,
    required: true,
    errors: field.getErrors('defaultTemplate')
}) }}