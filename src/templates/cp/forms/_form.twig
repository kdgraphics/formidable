{% extends "_layouts/cp" %}

{% set bodyClass = ['formidable'] %}

{% set selectedSubnavItem = 'formidable-forms' %}

{% set tabs = {dummy: 'dummy'} %}

{% block toolbar %}
    <forms-toolbar></forms-toolbar>
{% endblock %}

{% block sidebar %}
    <forms-menu
        :all-forms="{{ forms ? forms|json_encode : '{}' }}"
    ></forms-menu>
{% endblock %}

{% block content %}
    <forms-tabs :tab="'{{ tab }}'"></forms-tabs>
    <forms-config
        :form-edited="{{ form }}"
        :all-emails="{{ emails ? emails|json_encode : '{}' }}"
        :all-captchas="{{ captchas ? captchas|json_encode : '{}' }}"
        :all-volumes="{{ volumes ? volumes|json_encode : '{}' }}"
    ></forms-config>
    <forms-fields
        :registered-fields="{{ registeredFields|json_encode }}"
    >
    </forms-fields>
    <forms-rules
        :registered-rules="{{ registeredRules ? registeredRules|json_encode : '{}' }}"
    ></forms-rules>
    <confirm-dialog></confirm-dialog>
{% endblock %}
