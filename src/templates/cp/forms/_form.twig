{% extends "_layouts/cp" %}

{% set bodyClass = ['inspireforms'] %}

{% block toolbar %}
    <forms-toolbar></forms-toolbar>
{% endblock %}

{% block sidebar %}
    <forms-menu :menu="'{{ menu }}'"></forms-menu>
{% endblock %}

{% block content %}
    <forms-config
        :form-edited="{{ form|json_encode }}"
        :all-notifications="{{ notifications ? notifications|json_encode : '{}' }}"
        :all-captchas="{{ captchas ? captchas|json_encode : '{}' }}"
        :all-volumes="{{ volumes ? volumes|json_encode : '{}' }}"
    ></forms-config>
    <forms-fields
        :registered-fields="{{ registeredFields|json_encode }}"
        :all-fields="{{ fields|json_encode }}"
    >
    </forms-fields>
    <forms-rules
        :valid-types="{{ validConditions|json_encode }}"
        :registered-rules="{{ registeredRules ? registeredRules|json_encode : '{}' }}"
        :all-rules="{{ rules ? rules|json_encode : '[]' }}"
    ></forms-rules>
    <forms-submissions></forms-submissions>
    <forms-spam></forms-spam>
    <confirm-dialog></confirm-dialog>
{% endblock %}