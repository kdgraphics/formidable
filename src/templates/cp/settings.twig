{% import "_includes/forms" as forms %}

{% set errors = settings.getErrors() %}

{{ forms.autosuggestField({
    label: 'Google recaptcha site key'|t('formidable'),
    id: 'siteKey',
    name: 'siteKey',
    value: settings.siteKey,
    errors: settings.getErrors('siteKey'),
    suggestEnvVars: true,
    fieldClass: 'first'
    }) 
}}
{{ forms.autosuggestField({
    label: 'Google recaptcha secret key'|t('formidable'),
    id: 'secretKey',
    name: 'secretKey',
    value: settings.secretKey,
    errors: settings.getErrors('secretKey'),
    suggestEnvVars: true
    }) 
}}
{{ forms.selectizeField({
    label: 'Acceptable google captcha score'|t('formidable'),
    id: 'acceptableScore',
    name: 'acceptableScore',
    options: {0:0,1:0.1,2:0.2,3:0.3,4:0.4,5:0.5,6:0.6,7:0.7,8:0.8,9:0.9},
    value: settings['acceptableScore'],
    errors: settings.getErrors('acceptableScore'),
    })
}}

{{ forms.selectizeField({
    label: 'Form label CKEditor config'|t('formidable'),
    instructions: settings.isUsingDefaultLabelCkeditorConfig
        ? 'Uses the selected CKEditor field for HTML-enabled form labels. Expected handle: `formLabel`. Using internal default CKEditor config because no matching CKEditor field was found.'|t('formidable')
        : 'Uses the selected CKEditor field for HTML-enabled form labels. Expected handle: `formLabel`. Falls back to the built-in minimal toolbar if the field is not available.'|t('formidable'),
    options: settings.ckeditorConfigOptions,
    name: 'formLabelCkeditorConfig',
    value: settings.formLabelCkeditorConfig,
    errors: settings.getErrors('formLabelCkeditorConfig')
}) }}

{{ forms.selectizeField({
    label: 'Form tooltip CKEditor config'|t('formidable'),
    instructions: settings.isUsingDefaultTooltipCkeditorConfig
        ? 'Uses the selected CKEditor field for HTML-enabled tooltips. Expected handle: `formTooltip`. Using internal default CKEditor config because no matching CKEditor field was found.'|t('formidable')
        : 'Uses the selected CKEditor field for HTML-enabled tooltips. Expected handle: `formTooltip`. Falls back to the built-in minimal toolbar if the field is not available.'|t('formidable'),
    options: settings.ckeditorConfigOptions,
    name: 'formTooltipCkeditorConfig',
    value: settings.formTooltipCkeditorConfig,
    errors: settings.getErrors('formTooltipCkeditorConfig')
}) }}

{{
    forms.textField({
        type: 'number',
        min: 1,
        label: 'Automatically delete submissions older than'|t('formidable'),
        name: 'deleteSubmissionsThreshold',
        value: settings.deleteSubmissionsThreshold,
        errors: settings.getErrors('deleteSubmissionsThreshold'),
        unit: 'days',
        size: 30
    })
}}

{{
    forms.textField({
        type: 'number',
        min: 1,
        label: 'Automatically delete spams older than'|t('formidable'),
        name: 'deleteSpamThreshold',
        value: settings.deleteSpamThreshold,
        errors: settings.getErrors('deleteSpamThreshold'),
        unit: 'days',
        size: 30
    })
}}

{{
    forms.lightswitchField({
        label: 'Use the queue for emailing'|t('formidable'),
        name: 'useQueue',
        on: settings.useQueue
    })
}}
