{% import "_includes/forms" as forms %}

{% set errors = settings.getErrors() %}

{{ forms.textField({
    label: 'Google recaptcha site key'|t('formidable'),
    id: 'siteKey',
    name: 'siteKey',
    value: settings['siteKey'],
    warning: errors.siteKey.0 ?? false
    })
}}
{{ forms.textField({
    label: 'Google recaptcha secret key'|t('formidable'),
    id: 'secretKey',
    name: 'secretKey',
    value: settings['secretKey'],
    warning: errors.secretKey.0 ?? false
    })
}}
{{ forms.selectField({
    label: 'Acceptable google captcha score'|t('formidable'),
    id: 'acceptableScore',
    name: 'acceptableScore',
    options: {0:0,1:0.1,2:0.2,3:0.3,4:0.4,5:0.5,6:0.6,7:0.7,8:0.8,9:0.9},
    value: settings['acceptableScore'],
    warning: errors.acceptableScore.0 ?? false
    })
}}
{{ forms.lightswitchField({
    label: 'Send emails with a schedule'|t('formidable'),
    id: 'sendInSchedule',
    name: 'sendInSchedule',
    instructions: 'You must install a cron that calls the command \'formidable/send-emails\' for this to work',
    on: settings['sendInSchedule'],
    warning: errors.sendInSchedule.0 ?? false
    })
}}