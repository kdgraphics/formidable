{% from 'inspireforms/macros' import errorList %}

<div class="{{ field.containerClass }}">
	<div class="form-check">
		<input type="hidden" name="{{ field.name }}" value="0">
		<input type="checkbox"
		id="{{ field.generateId(form) }}"
		name="{{ field.name }}"
		class="{{ field.fieldClass }}{% if error %} is-invalid{% endif %}" 
		value="1"
		{% if field.required and field.enforceRequired %}required="required"{% endif %}
		{% if oldValue %}checked="checked"{% endif %}
		>
		{% if field.label %}
			<label for="{{ field.generateId(form) }}" class="{{ field.labelClass }}">
				{{ field.label }}{% if field.required %} *{% endif %}
			</label>
		{% endif %}
	</div>
	{% block instructions %}
		<div class="instructions">{{ field.instructions }}</div>
	{% endblock %}
	{% block errors %}{{ errorList(error) }}{% endblock %}
</div>