{% extends "formidable/fields/_field" %}

{% block inner %}
	<input type="text"
	id="{{ field.generateId(form) }}"
	name="{{ field.name }}"
	class="{{ field.fieldClass }}{% if error %} is-invalid{% endif %}" 
	value="{{ oldValue }}"
	{% if field.maxLength %}maxLength="{{ field.maxLength }}"{% endif %}
	{% if field.required and field.enforceRequired %}required="required"{% endif %}
	{% if field.placeholder %}placeholder="{{ field.placeholder }}"{% endif %}
	>
{% endblock %}