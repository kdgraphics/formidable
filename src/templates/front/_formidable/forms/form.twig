{% from '_formidable/macros' import errorList %}

{% set form_class = (form_class ?? '') ~ (form.class ? (' ' ~ form.class) : '') %}
{% set submit_class = (submit_class ?? '') ~ (form.submitClass ? (' ' ~ form.submitClass) : '') %}
{% set submit_container_class = submit_container_class ?? 'submit-wrapper' %}
{% set honeypot_class = honeypot_class ?? 'field' %}

{% block before_form %}{% endblock %}

<form id="{{ form.generateId() }}" action="" method="{{ form.method }}" class="form-{{ form.handle }} {{ form_class }} formidable" enctype="multipart/form-data"{% if not form.autocomplete %} autocomplete="off"{% endif %}>
	{{ csrfInput() }}
	{{ actionInput('formidable/forms/submit') }}
	{{ hiddenInput('id', form.id) }}
	{% block after_form_tag %}{% endblock %}
	{% block main_errors %}
		{% if posted.errors['*'] ?? false %}
			{{ errorList(posted.errors['*'], 'alert alert-danger') }}
		{% endif %}
	{% endblock %}
	{% block honeypot %}
		{% if form.honeypot %}
			{% include "_formidable/fields/_honeypot" %}
		{% endif %}
	{% endblock %}
	{% block fields %}
		{% include "_formidable/_includes/fields" %}
	{% endblock %}
	{% block captcha %}
		{% if form.captcha %}
			{{ form.getCaptcha().render(form)|raw }}
		{% endif %}
	{% endblock %}
	{% block submit %}
		{% include "_formidable/_includes/submit" %}
	{% endblock %}
	{% block before_end_form_tag %}{% endblock %}
</form>

{% block after_form %}{% endblock %}