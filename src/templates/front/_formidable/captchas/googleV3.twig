{% set id = form.generateId() %}

<input type="hidden" name="_recaptcha_response" id="{{ id }}">

{% if site_key is empty %}
	{{ 'The site key was not set for the Forms plugin, Please visit the settings page to add the key'|t('formidable') }}
{% else %}
	{% js %}
		document.addEventListener("DOMContentLoaded", function() {
			googleV3Captcha.init('{{ site_key }}');
			grecaptcha.ready(function () {
				googleV3Captcha.setFormCaptcha('{{ form.generateId() }}', 'submit');
			});
		});
	{% endjs %}
{% endif %}
