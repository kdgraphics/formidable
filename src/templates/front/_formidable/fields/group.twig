{% extends "_formidable/fields/_field" %}

{% set group_fields_class = (group_fields_class ?? 'fields') ~ (field.fieldClass ? (' ' ~ field.fieldClass) : '') %}

{% block inner %}
    {% if field.fields|length %}
        <div class="{{ group_fields_class }}">
            {% for subfield in field.fields %}
                {% include "_formidable/fields/field" with {
                    field: subfield
                } %}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}