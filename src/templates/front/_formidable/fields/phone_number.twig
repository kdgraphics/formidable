{% extends floating_field ? "_formidable/fields/_floatingfield" : "_formidable/fields/_field" %}

{% set field_class = (field_class ?? 'form-control') ~ (field.fieldClass ? (' ' ~ field.fieldClass) : '') %}

{% do view.registerAssetBundle("Inspire\\Formidable\\Assets\\PhoneInputAsset") %}

{% block inner %}
	<input type="tel"
	id="{{ field.generateId(form) }}-input"
	name="{{ field.frontName }}"
	data-formidable-phone-input
	data-initial-country="{{ formidable.countryResolver.getPhoneFieldCountryCode() }}"
	class="{{ field_class }}{% if error %} is-invalid{% endif %}" 
	value="{{ old_value }}"
	{% if field.placeholder %}placeholder="{{ field.placeholder }}"{% endif %}
	{% if not field.autocomplete %}autocomplete="off"{% endif %}
	>
{% endblock %}
