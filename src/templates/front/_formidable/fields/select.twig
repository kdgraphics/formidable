{% extends "_formidable/fields/_field" %}

{% set field_class = (field_class ?? '') ~ (field.fieldClass ? (' ' ~ field.fieldClass) : '') %}

{% block inner %}
	<select
	id="{{ field.generateId(form) }}-input"
	name="{{ field.frontName }}{% if field.multiple %}[]{% endif %}"
	class="{{ field_class }}{% if errors %} is-invalid{% endif %}"
	{% if field.multiple %}multiple{% endif %}
	{% if not field.autocomplete %}autocomplete="off"{% endif %}
	>
		{% if field.emptyOptionLabel %}
			<option value="">{{ field.emptyOptionLabel|t }}</option>
		{% endif %}
		{% for id, option in field.availableOptions %}
			<option value="{{ id }}" {% if old_value and (id in old_value) %}selected="selected"{% endif %}>{{ option }}</option>
		{% endfor %}
	</select>
{% endblock %}