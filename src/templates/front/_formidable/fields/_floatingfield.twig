{% set container_class = (container_class ?? '') ~ (field.containerClass ? (' ' ~ field.containerClass) : '') %}

<div class="{{ container_class }}">
	<div class="form-floating field" id="{{ field.generateId(form) }}">
		{% block before_field %}
		{% endblock %}
		{% block inner %}
		{% endblock %}
		{% block label %}
			{% include "_formidable/_includes/label" %}
		{% endblock %}
		{% block tooltip %}
			{% include "_formidable/_includes/tooltip" %}
		{% endblock %}
		{% block instructions %}
			{% include "_formidable/_includes/instructions" %}
		{% endblock %}
		{% block errors %}
			{% include "_formidable/_includes/errors" %}
		{% endblock %}
		{% block after_field %}
		{% endblock %}
	</div>
</div>