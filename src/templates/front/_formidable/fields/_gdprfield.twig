{% set container_class = (container_class ?? '') ~ (field.containerClass ? (' ' ~ field.containerClass) : '') %}
{% set label_class = (label_class ?? '') ~ (field.labelClass ? (' ' ~ field.labelClass) : '') %}

<div class="{{ container_class }} field" id="{{ field.generateId(form) }}">
	{% block before_field %}
	{% endblock %}
	<div class="row">
		<div class="{{ gdpr_label_class ?? 'col-md-8 mb-1 mb-mb-0' }}">
			{% block label %}
				<label for="{{ field.generateId(form) }}-input" class="form-label {{ label_class }}">
					{{ field.label|raw }}
				</label>
			{% endblock %}
			{% block tooltip %}
				{% include "_formidable/_includes/tooltip" %}
			{% endblock %}
			{% block instructions %}
				{% include "_formidable/_includes/instructions" %}
			{% endblock %}
		</div>
		<div class="{{ gdpr_select_class ?? 'col-md-4' }}">
			{% block inner %}
			{% endblock %}
		</div>
	</div>
	{% block errors %}
		{% include "_formidable/_includes/errors" %}
	{% endblock %}
	{% block after_field %}
	{% endblock %}
</div>