{% extends floating_field ? "_formidable/fields/_floatingfield" : "_formidable/fields/_field" %}

{% set field_class = (field_class ?? 'form-control') ~ (field.fieldClass ? (' ' ~ field.fieldClass) : '') %}

{% block inner %}
	<textarea id="{{ field.generateId(form) }}-input" name="{{ field.frontName }}" class="{{ field_class }}{% if error %} is-invalid{% endif %}"
	{% if field.placeholder %}placeholder="{{ field.placeholder }}"{% endif %}
	{% if field.rows %}rows="{{ field.rows }}"{% endif %}
	{% if not field.autocomplete %}autocomplete="off"{% endif %}
	style="height: {{ field.rows ? 39 + field.rows * 20 : '100px' }};">{{ old_value }}</textarea>
{% endblock %}