{% set field_class = (field_class ?? 'form-check-input') ~ (field.fieldClass ? (' ' ~ field.fieldClass) : '') %}
{% set container_class = (container_class ?? '') ~ (field.containerClass ? (' ' ~ field.containerClass) : '') %}
{% set label_class = (label_class ?? 'form-check-label') ~ (field.labelClass ? (' ' ~ field.labelClass) : '') %}
{% set field_choice_container_class = field_choice_container_class ?? 'form-check' %}

<div class="{{ container_class }} field" id="{{ field.generateId(form) }}">
	{% block before_field %}
	{% endblock %}
	{% block inner %}
		<div class="{{ field_choice_container_class }}">
			<input type="hidden" name="{{ field.frontName }}" value="0">
			<input type="checkbox"
				   id="{{ field.generateId(form) }}-input"
				   name="{{ field.frontName }}"
				   class="{{ field_class }}{% if error %} is-invalid{% endif %}"
				   value="1"
				   {% if old_value %}checked="checked"{% endif %}
					{% if not field.autocomplete %}autocomplete="off"{% endif %}
			>
			{% if field.label %}
				<label for="{{ field.generateId(form) }}-input" class="{{ label_class }}">
					{{ field.label|raw }}
				</label>
			{% endif %}
		</div>
	{% endblock %}
	{% block tooltip %}
		{% include "_formidable/_includes/tooltip" %}
	{% endblock %}
	{% block instructions %}
		{% include "_formidable/_includes/instructions" %}
	{% endblock %}
	{% block errors %}
		{% include "_formidable/_includes/errors" %}
	{% endblock %}
	{% block after_field %}
	{% endblock %}
</div>