{% extends "_formidable/fields/_field" %}

{% set field_class = (field_class ?? '') ~ (field.fieldClass ? (' ' ~ field.fieldClass) : '') %}
{% set field_option_container_class = (field_option_container_class ?? '') ~ (field.optionContainerClass ? (' ' ~ field.optionContainerClass) : '') %}
{% set field_option_label_class = (field_option_label_class ?? '') ~ (field.optionLabelClass ? (' ' ~ field.optionLabelClass) : '') %}

{% block inner %}
	{% for id, option in field.availableOptions %}
		<div class="{{ field_option_container_class }}">
			<input
				type="radio"
				value="{{ id }}"
				id="{{ field.generateId(form) }}-{{ loop.index }}"
				name="{{ field.frontName }}"
				class="{{ field_class }}{% if errors %} is-invalid{% endif %}"
				{% if old_value and (id == old_value) %}checked="checked"{% endif %}
				{% if not field.autocomplete %}autocomplete="off"{% endif %}
			>
			<label class="{{ field_option_label_class }}" for="{{ field.generateId(form) }}-{{ loop.index }}">{{ option }}</label>
		</div>
	{% endfor %}
{% endblock %}