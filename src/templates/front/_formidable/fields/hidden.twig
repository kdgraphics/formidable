{% set field_class = (field_class ?? '') ~ (field.fieldClass ? (' ' ~ field.fieldClass) : '') %}

{% block inner %}
<input type="hidden"
	id="{{ field.generateId(form) }}"
	name="{{ field.frontName }}"
	class="{{ field_class }}{% if errors %} is-invalid{% endif %}" 
	value="{{ old_value }}"
	{% if not field.autocomplete %}autocomplete="off"{% endif %}
	>
{% endblock %}