{% extends "formidable/fields/_field" %}

{% block inner %}
	<select
	id="{{ field.generateId(form) }}"
	name="{{ field.name }}"
	class="{{ field.fieldClass }}{% if error %} is-invalid{% endif %}"
	>
		{% for choice in field.choices %}
			<option value="{{ choice.value == '{empty}' ? '' : choice.value }}">{{ choice.label }}</option>
		{% endfor %}
	</select>
{% endblock %}