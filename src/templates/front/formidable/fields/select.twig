{% extends "formidable/fields/_field" %}

{% set field_class = (field_class ?? '') ~ (field.fieldClass ? (' ' ~ field.fieldClass) : '') %}

{% block inner %}
	<select
	id="{{ field.generateId(form) }}"
	name="{{ field.frontName }}{% if field.multiple %}[]{% endif %}"
	class="{{ field_class }}{% if error %} is-invalid{% endif %}"
	{% if field.multiple %}multiple{% endif %}
	{% if not field.autocomplete %}autocomplete="off"{% endif %}
	>
		{% for choice in field.choices %}
			<option value="{{ choice.value == '{empty}' ? '' : choice.value }}" {% if old_value and (choice.value == old_value) %}selected="selected"{% endif %}>{{ choice.label }}</option>
		{% endfor %}
	</select>
{% endblock %}