{% from 'formidable/macros' import errorList %}

<div class="{{ field.containerClass }} field">
	<input type="hidden" name="{{ field.handle }}" value="0">
	<input type="checkbox"
	id="{{ field.generateId(form) }}"
	name="{{ field.handle }}"
	class="{{ field.fieldClass }}{% if error %} is-invalid{% endif %}" 
	value="1"
	{% if old_value %}checked="checked"{% endif %}
	>
	{% if field.label %}
		<label for="{{ field.generateId(form) }}" class="{{ field.labelClass }}">
			{{ field.label|raw }}
		</label>
	{% endif %}
	{% block instructions %}
		<div class="instructions">{{ field.instructions }}</div>
	{% endblock %}
	{% block errors %}
		<div class="errors">
			{{ errorList(error) }}
		</div>
	{% endblock %}
</div>