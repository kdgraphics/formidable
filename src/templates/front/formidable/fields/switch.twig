<div class="{{ field.containerClass }} field">
	{% block before_field %}
	{% endblock %}
	{% block inner %}
		<input type="hidden" name="{{ field.handle }}" value="0">
		<input type="checkbox"
		id="{{ field.generateId(form) }}"
		name="{{ field.handle }}"
		class="{{ field_class }}{% if error %} is-invalid{% endif %}" 
		value="1"
		{% if old_value %}checked="checked"{% endif %}
		>
	{% endblock %}
	{% block label %}
		{% include "formidable/_includes/label" %}
	{% endblock %}
	{% block tooltip %}
		{% include "formidable/_includes/tooltip" %}
	{% endblock %}
	{% block instructions %}
		{% include "formidable/_includes/instructions" %}
	{% endblock %}
	{% block errors %}
		{% include "formidable/_includes/errors" %}
	{% endblock %}
	{% block after_field %}
	{% endblock %}
</div>