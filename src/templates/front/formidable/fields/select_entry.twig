{% extends "formidable/fields/_field" %}

{% block inner %}
	<select
	id="{{ field.generateId(form) }}"
	name="{{ field.handle }}"
	class="{{ field_class }}{% if error %} is-invalid{% endif %}"
	>
        {% if field.includeSelect %}
            <option value="">{{ field.selectLabel }}</option>
        {% endif %}
		{% for id, name in field.getEntries() %}
			<option value="{{ id }}" {% if old_value and (id == old_value) %}selected="selected"{% endif %}>{{ name }}</option>
		{% endfor %}
	</select>
{% endblock %}