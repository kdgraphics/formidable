{% set container_class = (container_class ?? '') ~ (field.containerClass ? (' ' ~ field.containerClass) : '') %}

<div class="{{ container_class }} group-{{ field.handle }}">
    {% block before_field %}
    {% endblock %}
    {% block label %}
        {% include "formidable/_includes/label" %}
    {% endblock %}
    {% block tooltip %}
        {% include "formidable/_includes/tooltip" %}
    {% endblock %}
    {% block inner %}
        {% if field.fields|length %}
            <div class="fields">
                {% for subfield in field.fields %}
                    {% set error = errors[subfield.handle] is defined ? errors[subfield.handle] : false %}
                    {% set old_value = oldInput[subfield.handle] ?? subfield.value %}
                    {% include "formidable/fields/field" with {field: subfield} %}
                {% endfor %}
            </div>
        {% endif %}
    {% endblock %}
    {% block errors %}
        {% include "formidable/_includes/errors" %}
    {% endblock %}
    {% block after_field %}
    {% endblock %}
</div>