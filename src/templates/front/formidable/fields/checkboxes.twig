{% extends "formidable/fields/_field" %}

{% block inner %}
	{% for key, choice in field.choices %}
		<div class="{{ field.choiceContainerClass }}">
			<input
				type="checkbox"
				value="{{ choice.value == '{empty}' ? '' : choice.value }}"
				id="{{ field.generateId(form) }}-{{ key }}"
				name="{{ field.handle }}[]"
				class="{{ field.fieldClass }}{% if error %} is-invalid{% endif %}"
				{% if old_value and (choice.value in old_value) %}checked="checked"{% endif %}
			>
			<label class="{{ field.choiceLabelClass }}" for="{{ field.generateId(form) }}-{{ key }}">{{ choice.label }}</label>
		</div>
	{% endfor %}
{% endblock %}