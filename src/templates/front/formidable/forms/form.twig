{% from 'formidable/macros' import errorList %}

{% set id = 'inspireform-'~form.handle~form.id %}

<form id="{{ id }}" action="/formidable/submit/{{ form.id }}" method="{{ form.method }}" class="{{ form.class }}"{#  enctype="multipart/form-data" #}>
	{{ csrfInput() }}
	{% if form.honeypot %}
		{% include "formidable/fields/_honeypot" %}
	{% endif %}
	{% for field in fields %}
		{% set error = errors[field.name] is defined ? errors[field.name] : false %}
		{% set oldValue = oldInput[field.name] is defined ? oldInput[field.name] : null %}
		{% include field.frontendTemplate() %}
	{% endfor %}
	{% if form.captcha %}
		{{ form.getCaptcha().render()|raw }}
	{% endif %}
	<button type="submit" class="btn btn-primary" id="submit">{{ form.submitLabel }}</button>
</form>

{% if form.honeypot %}
	{% js %}
		document.addEventListener('DOMContentLoaded', (event) => {
			document.getElementById('{{ id }}').querySelector("[id=field-{{ form.honeypotField }}]").style.display = "none";
		});
	{% endjs %}
{% endif %}