{% from 'formidable/macros' import errorList %}

{% set error = errors['*'] is defined ? errors['*'] : false %}

<form id="{{ form.generateId() }}" action="{{ currentSite.getBaseUrl() }}formidable/submit/{{ form.id }}" method="{{ form.method }}" class="form-{{ form.handle }} {{ form.class }} formidable" enctype="multipart/form-data">
	{% block mainErrors %}
		{% if error %}
			{{ errorList(error, 'alert alert-danger') }}
		{% endif %}
	{% endblock %}
	{% block csrfInput %}
		{{ csrfInput() }}
	{% endblock %}
	{% block honeypot %}
		{% if form.honeypot %}
			{% include "formidable/fields/_honeypot" %}
		{% endif %}
	{% endblock %}
	{% block fields %}
		{% for field in fields %}
			{% set error = errors[field.handle] is defined ? errors[field.handle] : false %}
			{% set old_value = oldInput[field.handle] is defined ? oldInput[field.handle] : null %}
			{% include field.frontendTemplate() %}
		{% endfor %}
	{% endblock %}
	{% block captcha %}
		{% if form.captcha %}
			{{ form.getCaptcha().render()|raw }}
		{% endif %}
	{% endblock %}
	{% block submit %}
		<div class="submit-wrapper">
			<button type="submit" class="{{ form.submitClass }}" id="submit">{{ form.submitLabel }}</button>
		</div>
	{% endblock %}
</form>

{% js %}
	{{ form.getFrontJs()|raw }}
{% endjs %}