{% from 'formidable/macros' import errorList %}

{% set error = errors['*'] is defined ? errors['*'] : false %}

{% set form_class = (class ?? '') ~ (form.class ? (' ' ~ form.class) : '') %}
{% set submit_class = (submit_class ?? '') ~ (form.submitClass ? (' ' ~ form.submitClass) : '') %}
{% set submit_container_class = submit_container_class ?? 'submit-wrapper' %}
{% set honeypot_class = honeypot_class ?? 'field' %}
{% set fields_class = fields_class ?? 'fields' %}

<form id="{{ form.generateId() }}" action="{{ currentSite.getBaseUrl() }}formidable/submit/{{ form.id }}" method="{{ form.method }}" class="form-{{ form.handle }} {{ form_class }} formidable" enctype="multipart/form-data">
	{% block mainErrors %}
		{% if error %}
			{{ errorList(error, 'alert alert-danger') }}
		{% endif %}
	{% endblock %}
	{% block csrfInput %}
		{{ csrfInput() }}
	{% endblock %}
	{% block honeypot %}
		{% if form.honeypot %}
			{% include "formidable/fields/_honeypot" %}
		{% endif %}
	{% endblock %}
	{% block fields %}
		<div class="{{ fields_class }}">
			{% for field in fields %}
				{% set error = errors[field.handle] is defined ? errors[field.handle] : false %}
				{% set old_value = oldInput[field.handle] ?? field.value %}
				{% include "formidable/fields/field" %}
			{% endfor %}
		</div>
	{% endblock %}
	{% block captcha %}
		{% if form.captcha %}
			{{ form.getCaptcha().render(form)|raw }}
		{% endif %}
	{% endblock %}
	{% block submit %}
		{% include "formidable/_includes/submit" %}
	{% endblock %}
</form>

{% js %}
	{{ form.getFrontJs()|raw }}
{% endjs %}